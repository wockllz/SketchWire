<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#04070d" />
  <title>SketchWire — Studio</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✏️</text></svg>" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="bg-aurora"></div>
  <div class="bg-grid"></div>

  <div class="shell">

    <header class="topbar">
      <div class="brand">
        <div class="brand-mark">✏️</div>
        <div>
          <div class="brand-title">SKETCHWIRE</div>
          <div class="brand-subtitle">DRAW IT. AI BUILDS IT.</div>
        </div>
      </div>

      <div class="board-controls">
        <select id="board-select" title="Board"></select>
        <button id="new-board-btn" class="chip-btn" type="button">+ BOARD</button>
      </div>

      <div class="top-status">
        <div class="status-item">
          <span class="status-label">OLLAMA</span>
          <span id="ollama-status" class="status-value offline">CHECKING…</span>
        </div>
        <div class="status-item">
          <span class="status-label">MODEL</span>
          <select id="model-select"><option value="">loading…</option></select>
        </div>
        <div class="status-item">
          <span class="status-label">SYNC</span>
          <span id="ws-status" class="status-value online">LIVE</span>
        </div>
      </div>
    </header>

    <main class="grid">

      <!-- LEFT: tools + properties -->
      <aside class="col-left">
        <section class="card tools-card">
          <div class="card-caption">DRAWING TOOLS</div>
          <div class="tool-grid" id="tool-grid">
            <button class="tool-btn active" data-tool="select" type="button" title="Select / move">✥<span>SELECT</span></button>
            <button class="tool-btn" data-tool="box" type="button" title="Container box">▢<span>BOX</span></button>
            <button class="tool-btn" data-tool="heading" type="button" title="Big heading">T<span>HEADING</span></button>
            <button class="tool-btn" data-tool="text" type="button" title="Paragraph text">≡<span>TEXT</span></button>
            <button class="tool-btn" data-tool="button" type="button" title="Action button">⬒<span>BUTTON</span></button>
            <button class="tool-btn" data-tool="image" type="button" title="Image placeholder">▣<span>IMAGE</span></button>
            <button class="tool-btn" data-tool="divider" type="button" title="Divider line">—<span>DIVIDER</span></button>
            <button class="tool-btn" data-tool="input" type="button" title="Input field">▭<span>INPUT</span></button>
          </div>
          <button id="clear-board-btn" class="chip-btn danger" type="button">CLEAR BOARD</button>
        </section>

        <section class="card props-card">
          <div class="card-caption">PROPERTIES</div>
          <div id="props-zone" class="props-zone">
            <div class="empty">Select an element to edit it.</div>
          </div>
        </section>

        <section class="card feed-card">
          <div class="card-caption">AGENT FEED</div>
          <div id="feed" class="feed">
            <div class="feed-hint">MUSE, SMITH and PRISM are standing by.</div>
          </div>
        </section>
      </aside>

      <!-- CENTER: the stage -->
      <section class="col-center">
        <section class="card stage-card">
          <div class="card-head">
            <div class="card-caption" id="board-label">BOARD</div>
            <div class="mode-toggle">
              <button id="mode-2d" class="mode-btn active" type="button">2D EDIT</button>
              <button id="mode-3d" class="mode-btn" type="button">✦ 3D BLUEPRINT</button>
            </div>
            <div class="stage-stepper" id="stage-stepper">
              <div class="stage" data-stage="planning"><span class="stage-dot"></span>PLAN</div>
              <div class="stage-sep"></div>
              <div class="stage" data-stage="building"><span class="stage-dot"></span>BUILD</div>
              <div class="stage-sep"></div>
              <div class="stage" data-stage="verifying"><span class="stage-dot"></span>VERIFY</div>
              <div class="stage-sep"></div>
              <div class="stage" data-stage="complete"><span class="stage-dot"></span>SHIP</div>
            </div>
          </div>
          <div class="stage-wrap">
            <canvas id="board" width="1000" height="640"></canvas>
            <canvas id="board3d" width="1000" height="640" class="hidden"></canvas>
            <div class="mission-pill-wrap"><div id="mission-pill" class="mission-pill">STANDBY</div></div>
          </div>
        </section>
      </section>

      <!-- RIGHT: imagine + agents + prototype -->
      <aside class="col-right">
        <section class="card imagine-card">
          <div class="card-caption">IMAGINE — DESCRIBE IT, MUSE DRAWS IT</div>
          <div class="viz-wrap"><canvas id="viz" height="92"></canvas></div>
          <textarea id="imagine-input" rows="3" maxlength="500"
            placeholder="Describe the page you want…
e.g. a coffee shop landing page with a hero, menu and newsletter signup"></textarea>
          <button id="imagine-btn" class="action-btn primary" type="button">✦ IMAGINE WIREFRAME</button>
          <button id="prototype-btn" class="action-btn" type="button">⚒ BUILD REAL APP FROM BOARD</button>
          <div id="imagine-error" class="forge-error"></div>
        </section>

        <section class="card agents-card">
          <div class="card-caption">AGENT NETWORK</div>
          <div id="agents" class="agents"></div>
        </section>

        <section class="card preview-card">
          <div class="card-caption">PROTOTYPE</div>
          <div id="preview-zone" class="preview-zone">
            <div class="empty">No prototype yet. Imagine a wireframe, then hit BUILD.</div>
          </div>
          <div id="preview-meta" class="preview-meta"></div>
          <div id="preview-actions" class="preview-actions hidden">
            <a id="preview-link" class="action-btn primary" target="_blank" rel="noopener">↗ OPEN PREVIEW</a>
          </div>
        </section>
      </aside>

    </main>

    <footer class="footer">
      <span>SKETCHWIRE • NTSHUXEKO SAMBO</span>
      <span>REAL-TIME COLLAB • LOCAL-FIRST • OLLAMA POWERED</span>
    </footer>

  </div>

  <script src="/js/viz.js"></script>
  <script src="/js/blueprint3d.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
